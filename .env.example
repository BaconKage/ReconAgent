# Optional. Without a key, ReconAgent runs from committed reasoning traces and
# every metric still reproduces - the deterministic engine never uses an LLM.
#
# Set EITHER of these. If both are present, Anthropic wins unless overridden.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk...

# Optional overrides
# RECONAGENT_LLM_PROVIDER=openai      # force a provider: anthropic | openai
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5.6-terra          # or gpt-5.6-sol for the strongest tier

# ---------------------------------------------------------------------
# Optional. Only needed to pull a live settlement recon report; the
# committed fixture needs neither of these.
#
#     python -m integrations.razorpay --year 2026 --month 7 --out data/rzp
#
# TEST MODE ONLY. The adapter refuses a rzp_live_ key unless explicitly
# overridden - this project has no reason to touch a real account.
# Dashboard -> Test Mode -> Account & Settings -> API Keys -> Generate Key.
# ---------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
