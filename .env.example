# Optional. Without a key, ReconAgent runs from committed reasoning traces and
# every metric still reproduces - the deterministic engine never uses an LLM.
#
# Set EITHER of these. If both are present, Anthropic wins unless overridden.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional overrides
# RECONAGENT_LLM_PROVIDER=openai      # force a provider: anthropic | openai
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5.6-terra          # or gpt-5.6-sol for the strongest tier
